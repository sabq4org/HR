# Local synthetic demo only. Do not use personal information.
PORT=4317
# Production preview requires LOCAL_DEMO=true and still binds loopback only.
# Local SQLite needs no cloud service. The generated encryption key is stored
# with owner-only permissions in .data/hr-data.key; preserve it with backups.

# Optional PostgreSQL development, on a dedicated HR database only:
# HR_DB_DRIVER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# HR_DATA_KEY=32_BYTE_BASE64URL_SECRET_FROM_YOUR_SECRET_MANAGER
# Never commit actual values. Generate a key once; don't change it on restart.

# Private finance workspace: the exact, verified employee ID for the authorized user.
# No default and no automatic grant to HR/finance roles. Ignored in public previews.
# HR_FINANCE_EMPLOYEE_ID=VERIFIED_EMPLOYEE_ID
# Enter the Wafeq Accounting API key through the private finance settings UI.
# It is encrypted with HR_DATA_KEY; it is never placed in VITE_* variables or Git.

# Hosted synthetic preview (never real employee data):
# HR_MODE=hosted-demo
# HR_PUBLIC_ORIGIN=https://your-demo.example
# Run npm run build then npm start. Do not set HR_DB_PATH in hosted mode.
# Leave DATABASE_URL unset for isolated in-memory preview workspaces.
# Optional hosted PostgreSQL creates temporary schemas per visitor; configure
# orphan cleanup before enabling it for a long-lived hosted environment.
